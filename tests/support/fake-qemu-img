#!/usr/bin/env bash
set -Eeuo pipefail
cmd="$1"; shift
case "$cmd" in
  create)
    backing= out= size=
    while (($#)); do
      case "$1" in
        -f|-F) shift 2 ;;
        -b) backing="$2"; shift 2 ;;
        [0-9]*G) size="$1"; shift ;;
        *) [[ -z "$out" ]] && out="$1"; shift ;;
      esac
    done
    [[ -n "$out" ]] || exit 3
    printf 'backing=%s\nsize=%s\n' "$backing" "$size" >"$out"
    ;;
  info)
    file="${@: -1}"; backing="$(sed -n 's/^backing=//p' "$file")"
    if [[ -n "$backing" ]]; then printf '{"format":"qcow2","backing-filename":"%s"}\n' "$backing"; else echo '{"format":"qcow2"}'; fi
    ;;
  check)
    [[ ! -e "$TEST_ROOT/fail-check" ]]
    [[ ! -e "$TEST_ROOT/fail-candidate-check" || "${@: -1}" != *promotion-candidate.qcow2 ]]
    if [[ -e "$TEST_ROOT/fail-post-install" && "${@: -1}" == *bitcoin-mainnet.qcow2 ]] &&
       grep -q '^standalone-from=' "${@: -1}"; then exit 1; fi
    if [[ -e "$TEST_ROOT/fail-rollback-install" && "${@: -1}" == *bitcoin-mainnet.qcow2 ]] &&
       grep -q '^rollback-image' "${@: -1}"; then exit 1; fi
    ;;
  convert)
    [[ ! -e "$TEST_ROOT/fail-convert" ]] || exit 1
    in="${@: -2:1}"; out="${@: -1}"; printf 'standalone-from=%s\n' "$(sha256sum "$in" | awk '{print $1}')" >"$out"
    ;;
  resize) : ;;
  *) exit 2 ;;
esac
