#!/usr/bin/env bash
set -Eeuo pipefail
[[ "${1:-}" == -c ]] && shift 2
cmd="${1:-}"; shift || true
vm_from_domain() { printf '%s' "${1#bvml-}"; }
case "$cmd" in
  version) echo 'mock libvirt 1' ;;
  dominfo)
    vm="$(vm_from_domain "$1")"
    [[ ! -e "$TEST_ROOT/undefined-$vm" ]] || exit 1
    echo 'Id: -'
    ;;
  domstate) vm="$(vm_from_domain "$1")"; cat "$TEST_ROOT/state-$vm" ;;
  domblklist)
    vm="$(vm_from_domain "$1")"
    printf 'Type Device Target Source\n--------------------------------\n'
    [[ -f "$TEST_ROOT/attach-$vm" ]] && awk '{print "file disk "$1" "$2}' "$TEST_ROOT/attach-$vm"
    ;;
  attach-disk)
    vm="$(vm_from_domain "$1")"; source="$2"; target="$3"
    [[ ! -e "$TEST_ROOT/fail-attach" ]] || exit 1
    if [[ -f "$TEST_ROOT/attach-$vm" ]]; then
      awk -v target="$target" '$1 != target' "$TEST_ROOT/attach-$vm" >"$TEST_ROOT/attach-$vm.new"
      mv "$TEST_ROOT/attach-$vm.new" "$TEST_ROOT/attach-$vm"
    fi
    printf '%s %s\n' "$target" "$source" >>"$TEST_ROOT/attach-$vm"
    printf 'attach %s %s\n' "$vm" "$source" >>"$TEST_ROOT/virsh.log"
    ;;
  detach-disk)
    vm="$(vm_from_domain "$1")"; target="$2"; [[ ! -e "$TEST_ROOT/fail-detach" ]] || exit 1
    if [[ -f "$TEST_ROOT/attach-$vm" ]]; then
      awk -v target="$target" '$1 != target' "$TEST_ROOT/attach-$vm" >"$TEST_ROOT/attach-$vm.new"
      if [[ -s "$TEST_ROOT/attach-$vm.new" ]]; then
        mv "$TEST_ROOT/attach-$vm.new" "$TEST_ROOT/attach-$vm"
      else
        rm -f -- "$TEST_ROOT/attach-$vm.new" "$TEST_ROOT/attach-$vm"
      fi
    fi
    printf 'detach %s %s\n' "$vm" "$target" >>"$TEST_ROOT/virsh.log"
    ;;
  start)
    vm="$(vm_from_domain "$1")"; [[ ! -e "$TEST_ROOT/fail-start" ]] || exit 1
    echo running >"$TEST_ROOT/state-$vm"
    ;;
  shutdown)
    vm="$(vm_from_domain "$1")"
    [[ -e "$TEST_ROOT/stuck-shutdown" ]] || echo 'shut off' >"$TEST_ROOT/state-$vm"
    ;;
  qemu-agent-command)
    [[ ! -e "$TEST_ROOT/fail-agent" ]] || exit 1
    payload="${2:-}"
    if [[ "$payload" == *guest-exec-status* ]]; then
      [[ -f "$TEST_ROOT/agent-status.json" ]] &&
        cat "$TEST_ROOT/agent-status.json" ||
        printf '{"return":{"exited":true,"exitcode":0}}\n'
    else
      printf '{"return":{"pid":42}}\n'
    fi
    ;;
  dumpxml)
    vm="$(vm_from_domain "$1")"
    printf '<domain><name>bvml-%s</name><devices/></domain>\n' "$vm"
    ;;
  define)
    rm -f -- "$TEST_ROOT/undefined-ubuntu"
    printf 'define\n' >>"$TEST_ROOT/virsh.log"
    ;;
  list) : ;;
  *) echo "unsupported fake virsh command: $cmd" >&2; exit 2 ;;
esac
