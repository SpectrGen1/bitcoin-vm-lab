# Copy to config/local.env and change paths and resources as needed.
# ISO paths must be absolute and are intentionally not downloaded by scripts.
UBUNTU_ISO=/var/lib/libvirt/boot/ubuntu-24.04.2-live-server-amd64.iso
UMBREL_ISO=/var/lib/libvirt/boot/umbrelOS-amd64.iso
STARTOS_ISO=/var/lib/libvirt/boot/startos-amd64.iso

# Pin this before provisioning Ubuntu. The bootstrap verifies SHA256SUMS.asc.
BITCOIN_VERSION=29.0
