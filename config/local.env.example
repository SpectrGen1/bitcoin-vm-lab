# Copy to config/local.env. All ISO paths and SHA-256 values are required.
UBUNTU_ISO=/var/lib/libvirt/boot/ubuntu.iso
UBUNTU_ISO_SHA256=
UMBREL_CREDENTIALS_FILE=/home/operator/.config/bvml/umbrel-credentials.json
UMBREL_SSH_PRIVATE_KEY=/home/operator/.ssh/bvml-umbrel
UMBREL_SSH_PUBLIC_KEY=/home/operator/.ssh/bvml-umbrel.pub
# Optional fixed address. If empty, bvml resolves the libvirt DHCP lease.
UMBREL_MANAGEMENT_ADDRESS=
UMBREL_ISO_SHA256=
STARTOS_ISO=/var/lib/libvirt/boot/startos.iso
STARTOS_ISO_SHA256=

# Unattended Ubuntu alternative. Pin a versioned or otherwise operator-reviewed
# cloud image URL and SHA-256; media-fetch refuses an unpinned moving artifact.
UBUNTU_IMAGE_MODE=cloud
BVML_MEDIA_DIR=/var/lib/libvirt/boot/bitcoin-vm-lab
UBUNTU_CLOUD_IMAGE=/var/lib/libvirt/boot/bitcoin-vm-lab/ubuntu-cloud.qcow2
UBUNTU_CLOUD_IMAGE_URL=
UBUNTU_CLOUD_IMAGE_SHA256=
UBUNTU_CLOUD_USER=ubuntu
UBUNTU_CLOUD_SSH_KEY=/home/operator/.ssh/id_ed25519.pub
LIBGUESTFS_APPLIANCE_PATH=/usr/share/guestfs/appliance
BVML_HOST_CONFIG_DIR=/etc/bvml

# Optional imports take an explicit source argument and stopped/snapshot
# assertion. Fresh IBD is the normal first-run path.
BOOTSTRAP_SIZE_GIB=1200

# Knots release and the exact, release-validated RDTS arguments. The bootstrap
# refuses to run when either is omitted.
KNOTS_VERSION_NORMALIZED=
KNOTS_ARTIFACT_SHA256=
KNOTS_RELEASE_PROFILE=/etc/bvml/releases/knots-version.env
KNOTS_RELEASE_PROFILE_SHA256=
KNOTS_RDTS_PROFILE=/etc/bvml/releases/knots-rdts.env
KNOTS_RDTS_PROFILE_SHA256=
KNOTS_RDTS_PROFILE_NAME=
KNOTS_RDTS_REQUIRED_ARGS_JSON='["-release-specific-option=expected-value"]'

# Authenticated profile inputs consumed by profiles-install.
KNOTS_ARCHIVE_NAME=
KNOTS_RELEASE_BASE_URL=
KNOTS_SHA256SUMS_SOURCE=
KNOTS_SHA256SUMS_ASC_SOURCE=
KNOTS_SIGNING_KEY_SOURCE=
KNOTS_SIGNER_FINGERPRINT=

# Machine-readable index contract and best-block freshness policy.
CHECKPOINT_PROFILE_SOURCE=/absolute/path/to/checkpoint-profile.json
CHECKPOINT_PROFILE_FILE=/etc/bvml/active/checkpoint-profile.json
CHECKPOINT_PROFILE_SHA256=
MAX_TIP_AGE_SECONDS=86400
ROLLBACK_RETENTION=none

# Adapter readiness is learned from successful exact-version guest validation,
# not from host-side supported-version variables.
