# Copy to config/local.env. All ISO paths and SHA-256 values are required.
UBUNTU_ISO=/var/lib/libvirt/boot/ubuntu.iso
UBUNTU_ISO_SHA256=
UMBREL_ISO=/var/lib/libvirt/boot/umbrelos.iso
UMBREL_ISO_SHA256=
STARTOS_ISO=/var/lib/libvirt/boot/startos.iso
STARTOS_ISO_SHA256=

# Existing synchronized, cleanly stopped Bitcoin datadir or snapshot.
BITCOIN_SOURCE=/home/brian/projects/bitcoin-knots-dev/bitcoin

# Knots release and the exact, release-validated RDTS arguments. The bootstrap
# refuses to run when either is omitted.
KNOTS_VERSION=
KNOTS_RDTS_ARGS=
# Authenticated SHA256SUMS file and detached signature, copied into the guest.
KNOTS_SHA256SUMS=/path/to/SHA256SUMS
KNOTS_SHA256SUMS_ASC=/path/to/SHA256SUMS.asc
KNOTS_SIGNING_KEY=/path/to/knots-release-signing-key.asc
KNOTS_SIGNER_FINGERPRINT=
KNOTS_ARCHIVE_NAME=
KNOTS_RELEASE_BASE_URL=https://bitcoinknots.org/files

# Optional platform release profiles. The adapters reject all other releases.
UMBREL_SUPPORTED_VERSION=
STARTOS_SUPPORTED_VERSION=
