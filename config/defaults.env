# Generated disks and state live in a system-libvirt-accessible location.
BVML_STORAGE="${BVML_STORAGE:-/var/lib/libvirt/images/bitcoin-vm-lab}"
LIBVIRT_URI="${LIBVIRT_URI:-qemu:///system}"
QEMU_USER="${QEMU_USER:-qemu}"
QEMU_GROUP="${QEMU_GROUP:-qemu}"
VM_CPUS="${VM_CPUS:-4}"
VM_MEMORY_MIB="${VM_MEMORY_MIB:-8192}"
VM_DISK_GIB="${VM_DISK_GIB:-80}"
APP_DISK_GIB="${APP_DISK_GIB:-80}"
BVML_NETWORK="${BVML_NETWORK:-default}"
BVML_BOOT_UEFI="${BVML_BOOT_UEFI:-1}"
CHECKPOINT_HEADROOM_PERCENT="${CHECKPOINT_HEADROOM_PERCENT:-20}"
BOOTSTRAP_SIZE_GIB="${BOOTSTRAP_SIZE_GIB:-1200}"
ROLLBACK_RETENTION="${ROLLBACK_RETENTION:-none}"
ROLLBACK_DESTINATION="${ROLLBACK_DESTINATION:-}"
SHUTDOWN_TIMEOUT="${SHUTDOWN_TIMEOUT:-180}"
GUEST_EXEC_TIMEOUT="${GUEST_EXEC_TIMEOUT:-900}"
KNOTS_VERSION_NORMALIZED="${KNOTS_VERSION_NORMALIZED:-}"
KNOTS_ARTIFACT_SHA256="${KNOTS_ARTIFACT_SHA256:-}"
KNOTS_RELEASE_PROFILE="${KNOTS_RELEASE_PROFILE:-}"
KNOTS_RELEASE_PROFILE_SHA256="${KNOTS_RELEASE_PROFILE_SHA256:-}"
KNOTS_RDTS_PROFILE="${KNOTS_RDTS_PROFILE:-}"
KNOTS_RDTS_PROFILE_SHA256="${KNOTS_RDTS_PROFILE_SHA256:-}"
KNOTS_RDTS_PROFILE_NAME="${KNOTS_RDTS_PROFILE_NAME:-}"
KNOTS_RDTS_REQUIRED_ARGS_JSON="${KNOTS_RDTS_REQUIRED_ARGS_JSON:-}"
CHECKPOINT_PROFILE_FILE="${CHECKPOINT_PROFILE_FILE:-$BVML_ROOT/config/checkpoint-profile-basic.json}"
CHECKPOINT_PROFILE_SOURCE="${CHECKPOINT_PROFILE_SOURCE:-$CHECKPOINT_PROFILE_FILE}"
CHECKPOINT_PROFILE_SHA256="${CHECKPOINT_PROFILE_SHA256:-84e6c555f12c0769a4d3037a36490ca1ce10924965ffedf75da5e7c847997988}"
CHECKPOINT_MIGRATION_PROFILE_SOURCE="${CHECKPOINT_MIGRATION_PROFILE_SOURCE:-$BVML_ROOT/config/checkpoint-profile-basic.json}"
CHECKPOINT_MIGRATION_PROFILE_SHA256="${CHECKPOINT_MIGRATION_PROFILE_SHA256:-84e6c555f12c0769a4d3037a36490ca1ce10924965ffedf75da5e7c847997988}"
MAX_TIP_AGE_SECONDS="${MAX_TIP_AGE_SECONDS:-86400}"
BITCOIN_DATADIR_UID="${BITCOIN_DATADIR_UID:-1000}"
BITCOIN_DATADIR_GID="${BITCOIN_DATADIR_GID:-1000}"

# Immutable official UmbrelOS/bitcoin-knots integration profile. Credentials
# and private SSH material are deliberately external to the repository.
UMBREL_PROFILE="${UMBREL_PROFILE:-$BVML_ROOT/profiles/umbrel/umbrelos-1.7.4-bitcoin-knots-1.2.12-patch.1.json}"
UMBREL_PROFILE_SHA256="${UMBREL_PROFILE_SHA256:-6143a5e643626e9868875adae344ef82ecfadbd6dda5959665ab854b0db5bb86}"
UMBREL_ISO_SHA256="${UMBREL_ISO_SHA256:-d30f4e495630b79e946cb6e98cc0f0404a72f69291df5debd7e8908bf106ac40}"
UMBREL_CREDENTIALS_FILE="${UMBREL_CREDENTIALS_FILE:-}"
UMBREL_SSH_PRIVATE_KEY="${UMBREL_SSH_PRIVATE_KEY:-}"
UMBREL_SSH_PUBLIC_KEY="${UMBREL_SSH_PUBLIC_KEY:-}"
UMBREL_SSH_USER="${UMBREL_SSH_USER:-umbrel}"
UMBREL_MANAGEMENT_ADDRESS="${UMBREL_MANAGEMENT_ADDRESS:-}"
UMBREL_SYSTEM_DISK_GIB="${UMBREL_SYSTEM_DISK_GIB:-160}"
UMBREL_INSTALL_MODEL="${UMBREL_INSTALL_MODEL:-QEMU HARDDISK}"
UMBREL_INSTALL_SERIAL="${UMBREL_INSTALL_SERIAL:-BVML-UMBREL-SYSTEM}"
UMBREL_INSTALL_TIMEOUT="${UMBREL_INSTALL_TIMEOUT:-2400}"
UMBREL_OPERATION_TIMEOUT="${UMBREL_OPERATION_TIMEOUT:-1200}"

# Immutable official StartOS/bitcoind Knots integration profile. StartOS
# management credentials and SSH keys remain outside this repository.
STARTOS_PROFILE="${STARTOS_PROFILE:-$BVML_ROOT/profiles/startos/startos-0.4.0.1-bitcoind-knots-29.3.1-16.json}"
STARTOS_PROFILE_SHA256="${STARTOS_PROFILE_SHA256:-58f3eb86ce1169866085d7166c5af34c1ae4bc9a7f50aafad9884ef7e617f6b2}"
STARTOS_ISO_SHA256="${STARTOS_ISO_SHA256:-9f4f5ad4ece2dc349b0a7b6221b542b26112fe753657024487fc26ef6cf08072}"
STARTOS_PACKAGE_SHA256="${STARTOS_PACKAGE_SHA256:-909683c4040ddb5392e0b604774cb94092de6d40063d2f1e2cfcaeacf46280af}"
STARTOS_CREDENTIALS_FILE="${STARTOS_CREDENTIALS_FILE:-}"
STARTOS_SSH_PRIVATE_KEY="${STARTOS_SSH_PRIVATE_KEY:-}"
STARTOS_SSH_PUBLIC_KEY="${STARTOS_SSH_PUBLIC_KEY:-}"
STARTOS_SSH_USER="${STARTOS_SSH_USER:-start9}"
STARTOS_MANAGEMENT_ADDRESS="${STARTOS_MANAGEMENT_ADDRESS:-}"
STARTOS_SYSTEM_DISK_GIB="${STARTOS_SYSTEM_DISK_GIB:-160}"
STARTOS_INSTALL_SERIAL="${STARTOS_INSTALL_SERIAL:-BVML-STARTOS-SYSTEM}"
STARTOS_DATA_SERIAL="${STARTOS_DATA_SERIAL:-BVML-STARTOS-DATA}"
STARTOS_INSTALL_MODEL="${STARTOS_INSTALL_MODEL:-QEMU HARDDISK}"
STARTOS_INSTALL_TIMEOUT="${STARTOS_INSTALL_TIMEOUT:-2400}"
STARTOS_OPERATION_TIMEOUT="${STARTOS_OPERATION_TIMEOUT:-14400}"
STARTOS_BTRFS_CONVERT_TIMEOUT="${STARTOS_BTRFS_CONVERT_TIMEOUT:-14400}"
STARTOS_BTRFS_ADAPTER_MAX_GIB="${STARTOS_BTRFS_ADAPTER_MAX_GIB:-128}"
STARTOS_BTRFS_ADAPTER_MAX_PERCENT="${STARTOS_BTRFS_ADAPTER_MAX_PERCENT:-15}"

# Reusable Electrum-server indexes. These are independent protected qcow2
# images bound to one Bitcoin canonical generation. Every platform receives a
# private writable overlay; the bases are never attached writable.
INDEX_PROFILE="${INDEX_PROFILE:-$BVML_ROOT/profiles/indexers/indexers-v1.json}"
INDEX_PROFILE_SHA256="${INDEX_PROFILE_SHA256:-74c7428d0894834113e012d201e71d617b7fe89337a02e7c664ffc720dc8cd6f}"
ELECTRS_BASE_SIZE_GIB="${ELECTRS_BASE_SIZE_GIB:-160}"
FULCRUM_BASE_SIZE_GIB="${FULCRUM_BASE_SIZE_GIB:-280}"
INDEX_BUILD_TIMEOUT="${INDEX_BUILD_TIMEOUT:-172800}"
INDEX_DEVICE_ELECTRS="${INDEX_DEVICE_ELECTRS:-/dev/vdd}"
INDEX_DEVICE_FULCRUM="${INDEX_DEVICE_FULCRUM:-/dev/vde}"

# Reproducible unattended Ubuntu provisioning. The URL and digest are
# deliberately unset: media-fetch never trusts a moving image without an
# operator-pinned SHA-256.
BVML_MEDIA_DIR="${BVML_MEDIA_DIR:-$BVML_STORAGE/media}"
UMBREL_ISO="${UMBREL_ISO:-$BVML_MEDIA_DIR/umbrelos-amd64-usb-installer-1.7.4.iso}"
STARTOS_ISO="${STARTOS_ISO:-$BVML_MEDIA_DIR/startos-0.4.0.1-x86_64.iso}"
STARTOS_PACKAGE="${STARTOS_PACKAGE:-$BVML_MEDIA_DIR/bitcoind-knots-29.3.1-16-x86_64.s9pk}"
STARTOS_CLI="${STARTOS_CLI:-$BVML_MEDIA_DIR/start-cli-1.1.0-x86_64}"
UBUNTU_IMAGE_MODE="${UBUNTU_IMAGE_MODE:-iso}"
UBUNTU_CLOUD_IMAGE="${UBUNTU_CLOUD_IMAGE:-$BVML_MEDIA_DIR/ubuntu-cloud.qcow2}"
UBUNTU_CLOUD_IMAGE_URL="${UBUNTU_CLOUD_IMAGE_URL:-}"
UBUNTU_CLOUD_IMAGE_SHA256="${UBUNTU_CLOUD_IMAGE_SHA256:-}"
UBUNTU_CLOUD_USER="${UBUNTU_CLOUD_USER:-ubuntu}"
UBUNTU_CLOUD_SSH_KEY="${UBUNTU_CLOUD_SSH_KEY:-}"
LIBGUESTFS_APPLIANCE_PATH="${LIBGUESTFS_APPLIANCE_PATH:-/usr/share/guestfs/appliance}"
BVML_HOST_CONFIG_DIR="${BVML_HOST_CONFIG_DIR:-/etc/bvml}"

# Inputs used by profiles-install. Signed metadata and the trusted signer key
# may be local absolute paths or HTTPS URLs; the release artifact remains a
# guest-side authenticated download.
KNOTS_ARCHIVE_NAME="${KNOTS_ARCHIVE_NAME:-}"
KNOTS_RELEASE_BASE_URL="${KNOTS_RELEASE_BASE_URL:-}"
KNOTS_SHA256SUMS_SOURCE="${KNOTS_SHA256SUMS_SOURCE:-}"
KNOTS_SHA256SUMS_ASC_SOURCE="${KNOTS_SHA256SUMS_ASC_SOURCE:-}"
KNOTS_SIGNING_KEY_SOURCE="${KNOTS_SIGNING_KEY_SOURCE:-}"
KNOTS_SIGNER_FINGERPRINT="${KNOTS_SIGNER_FINGERPRINT:-}"
