# Generated disks and state live in a system-libvirt-accessible location.
BVML_STORAGE="${BVML_STORAGE:-/var/lib/libvirt/images/bitcoin-vm-lab}"
LIBVIRT_URI="${LIBVIRT_URI:-qemu:///system}"
QEMU_USER="${QEMU_USER:-qemu}"
QEMU_GROUP="${QEMU_GROUP:-qemu}"
VM_CPUS="${VM_CPUS:-4}"
VM_MEMORY_MIB="${VM_MEMORY_MIB:-8192}"
VM_DISK_GIB="${VM_DISK_GIB:-80}"
APP_DISK_GIB="${APP_DISK_GIB:-80}"
BVML_NETWORK="${BVML_NETWORK:-default}"
BVML_BOOT_UEFI="${BVML_BOOT_UEFI:-1}"
BITCOIN_SOURCE="${BITCOIN_SOURCE:-$HOME/projects/bitcoin-knots-dev/bitcoin}"
CHECKPOINT_HEADROOM_PERCENT="${CHECKPOINT_HEADROOM_PERCENT:-20}"
SHUTDOWN_TIMEOUT="${SHUTDOWN_TIMEOUT:-180}"
KNOTS_VERSION="${KNOTS_VERSION:-}"
KNOTS_RDTS_ARGS="${KNOTS_RDTS_ARGS:-}"
