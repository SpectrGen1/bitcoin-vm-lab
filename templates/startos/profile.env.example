# Trusted, root-owned exact-version profile. Install its SHA-256 separately as
# /etc/bvml/startos-profile.sha256. Build/install behavior lives in the pinned
# implementation script, never in arbitrary shell strings in this file.
PROFILE_ID=startos-RELEASE-bitcoin-PACKAGE-v1
ADAPTER_IMPLEMENTATION_VERSION=1
SUPPORTED_OS_VERSION=
SUPPORTED_PACKAGE_VERSION=
PACKAGE_ID=
PACKAGE_PROJECT_DIR=/absolute/path/to/versioned/package/source
PACKAGE_CONTAINER_NAME=
CONTAINER_DATADIR=/data/.bitcoin
CONTAINER_KNOTS_EXE=/opt/bvml-knots/bin/bitcoind
EXPECTED_RUNTIME_UID=
EXPECTED_HEALTH_JSON='{}'
EXPECTED_DEPENDENCIES_JSON='{}'
BITCOIN_DEVICE=/dev/vdc
BITCOIN_MOUNT=/mnt/bvml-bitcoin
KNOTS_RELEASE_DIR=/opt/bvml/knots
KNOTS_BITCOIND_SHA256=
RDTS_REQUIRED_ARGS_JSON='[]'
PACKAGE_IMPLEMENTATION_SCRIPT=/usr/local/libexec/bvml/startos-package-implementation
PACKAGE_IMPLEMENTATION_SHA256=
