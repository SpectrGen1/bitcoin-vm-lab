# Install as root-owned mode 0644 /etc/bvml/knots.env in Ubuntu.
BITCOIN_MOUNT=/srv/bitcoin
BITCOIN_DEVICE=/dev/vdc
BITCOIN_SERVICE_USER=ubuntu
BITCOIN_SERVICE_GROUP=ubuntu
MAX_TIP_AGE_SECONDS=86400

KNOTS_RELEASE_PROFILE=/etc/bvml/releases/knots-version.env
KNOTS_RELEASE_PROFILE_SHA256=
KNOTS_RDTS_PROFILE=/etc/bvml/releases/knots-rdts.env
KNOTS_RDTS_PROFILE_SHA256=
CHECKPOINT_PROFILE_FILE=/etc/bvml/checkpoint-profile.json
CHECKPOINT_PROFILE_SHA256=
