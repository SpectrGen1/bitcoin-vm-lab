# Root-owned, non-group/world-writable exact Knots release profile.
# The authenticated checksum files and trusted key are local guest paths.
KNOTS_VERSION_NORMALIZED=
KNOTS_ARCHIVE_NAME=
KNOTS_RELEASE_BASE_URL=https://bitcoinknots.org/files
KNOTS_ARTIFACT_SHA256=
KNOTS_SHA256SUMS=/etc/bvml/releases/SHA256SUMS
KNOTS_SHA256SUMS_ASC=/etc/bvml/releases/SHA256SUMS.asc
KNOTS_SIGNING_KEY=/etc/bvml/releases/knots-release-signing-key.asc
KNOTS_SIGNER_FINGERPRINT=
