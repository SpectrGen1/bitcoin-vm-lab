# Trusted, root-owned exact-version profile. Install its SHA-256 separately as
# /etc/bvml/umbrel-profile.sha256. Do not use placeholder values.
PROFILE_ID=umbrel-RELEASE-bitcoin-PACKAGE-v1
ADAPTER_IMPLEMENTATION_VERSION=1
SUPPORTED_OS_VERSION=
SUPPORTED_APP_VERSION=
APP_ID=bitcoin
COMPOSE_PROJECT=
COMPOSE_FILE=/absolute/path/to/compose.yml
BITCOIN_SERVICE=bitcoin
EXPECTED_IMAGE=
EXPECTED_ENTRYPOINT_JSON='[]'
EXPECTED_COMMAND_JSON='[]'
EXPECTED_ENV_JSON='[]'
EXPECTED_RUNTIME_UID=
EXPECTED_ENDPOINTS_JSON='[]'
CONTAINER_DATADIR=/data/.bitcoin
CONTAINER_KNOTS_EXE=/opt/bvml-knots/bin/bitcoind
BITCOIN_DEVICE=/dev/vdc
BITCOIN_MOUNT=/mnt/bvml-bitcoin
KNOTS_RELEASE_DIR=/opt/bvml/knots
KNOTS_BITCOIND_SHA256=
RDTS_REQUIRED_ARGS_JSON='[]'
TRANSFORM_SCRIPT=/usr/local/libexec/bvml/umbrel-profile-implementation
TRANSFORM_SCRIPT_SHA256=
